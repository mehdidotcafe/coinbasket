{
  "name": "invest_agent",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "invest_agent/invest_agent",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run ruff format .",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "start": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python -m invest_agent.main",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {}
      },
      "cache": true
    },
    "dev": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["infra"],
      "options": {
        "command": "poetry run python -m invest_agent.main",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "cli": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["infra"],
      "options": {
        "command": "poetry run python -m invest_agent.cli",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run pytest -k \"not test_integration\"",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["infra:test"],
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "env-cmd -f .env.test poetry run pytest -k \"test_integration\"",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "cacheDir": ".cache/pypoetry",
        "verbose": false,
        "debug": false
      }
    },
    "infra": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose up -d",
        "cwd": "{projectRoot}"
      }
    },
    "infra:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f docker-compose-test.yml up -d --force-recreate",
        "cwd": "{projectRoot}"
      }
    },
    "infra:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose down",
        "cwd": "{projectRoot}"
      }
    },
    "infra:test:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f docker-compose-test.yml down",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "generator": "@nxlv/python:release-version"
    }
  }
}
