{
  "name": "invest_agent",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "invest_agent/invest_agent",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint:fix": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run ruff check --fix",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run ruff check",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "start": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python -m invest_agent.main",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {}
      },
      "cache": true
    },
    "dev": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["infra"],
      "options": {
        "command": "poetry run python -m invest_agent.main",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "cli": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["infra"],
      "options": {
        "command": "poetry run python -m invest_agent.cli",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run pytest -k \"not test_integration\"",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["infra:test", "migration:test:apply"],
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "../script/run_integration_tests.sh",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "cacheDir": ".cache/pypoetry",
        "verbose": false,
        "debug": false
      }
    },
    "infra": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d",
        "cwd": "{projectRoot}"
      }
    },
    "infra:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f docker-compose-test.yml up -d --force-recreate",
        "cwd": "{projectRoot}"
      }
    },
    "infra:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose down",
        "cwd": "{projectRoot}"
      }
    },
    "infra:test:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f docker-compose-test.yml down",
        "cwd": "{projectRoot}"
      }
    },
    "migration:init": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "yoyo init migration",
        "cwd": "{projectRoot}"
      }
    },
    "migration:new": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "yoyo new --database \"sqlite:///database/$AGENT_ENV/$AGENT_NAME.db\" -m \"{args}\"",
        "cwd": "{projectRoot}",
        "args": ""
      }
    },
    "migration:apply": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "yoyo apply --database \"sqlite:///database/$AGENT_ENV/$AGENT_NAME.db\" -b",
        "cwd": "{projectRoot}"
      }
    },
    "migration:test:apply": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "env-cmd -f .env.test --use-shell 'echo '' > database/$AGENT_ENV/$AGENT_NAME.db ; yoyo apply --database \"sqlite:///database/$AGENT_ENV/$AGENT_NAME.db\" -b'",
        "cwd": "{projectRoot}"
      }
    },
    "migration:rollback": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "yoyo rollback --database \"sqlite:///database/$AGENT_ENV/$AGENT_NAME.db\" -b",
        "cwd": "{projectRoot}"
      }
    },
    "migration:list": {
      "executor": "@nxlv/python:run-commands --database \"sqlite:///database/$AGENT_ENV/$AGENT_NAME.db\"",
      "options": {
        "command": "yoyo list",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "generator": "@nxlv/python:release-version"
    }
  }
}
