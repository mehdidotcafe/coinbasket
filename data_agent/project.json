{
  "name": "data_agent",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "data_agent/data_agent",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint:fix": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run ruff check --fix",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run ruff check",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "start": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["infra:production"],
      "options": {
        "command": "env-cmd -f .env.production --use-shell 'poetry run python -m data_agent.main'",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {}
      },
      "cache": true
    },
    "start:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          { "command": "nx start data_agent" }
        ],
        "parallel": true
      }
    },
    "dev": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["infra"],
      "options": {
        "command": "poetry run python -m data_agent.main",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "dev:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          { "command": "nx dev data_agent" }
        ],
        "parallel": true
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run pytest  -k \"not test_integration\"",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test:integration": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "../script/run_integration_tests.sh",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "cacheDir": ".cache/pypoetry",
        "verbose": false,
        "debug": false
      }
    },
    "infra": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d --force-recreate",
        "cwd": "{projectRoot}"
      }
    },
    "infra:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env-cmd -f .env.test --use-shell 'docker compose -f docker-compose-test.yml down -v && docker compose -f docker-compose-test.yml up -d --force-recreate'",
        "cwd": "{projectRoot}"
      }
    },
    "infra:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env-cmd -f .env.production --use-shell 'docker compose -f docker-compose-production.yml up -d'",
        "cwd": "{projectRoot}"
      }
    },
    "infra:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose down",
        "cwd": "{projectRoot}"
      }
    },
    "infra:test:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env-cmd -f .env.test docker compose -f docker-compose-test.yml down",
        "cwd": "{projectRoot}"
      }
    },
    "infra:production:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env-cmd -f .env.production docker compose -f docker-compose-production.yml down",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "generator": "@nxlv/python:release-version"
    }
  }
}
