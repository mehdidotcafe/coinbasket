{
  "name": "coinbasket-root",
  "version": "1.0.0",
  "targets": {
    "dev:data_agent": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./nx dev data_agent",
        "stream": true
      }
    },
    "dev:api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./nx dev api",
        "stream": true,
        "readyWhen": "Invest Agent Ready"
      }
    },
    "dev:worker:api": {
      "executor": "nx:run-commands",
      "dependsOn": ["dev:api"],
      "options": {
        "command": "./nx dev:worker api",
        "stream": true
      }
    },
    "dev:all": {
      "executor": "nx:run-commands",
      "dependsOn": ["dev:data_agent", "dev:worker:api"],
      "options": {
        "commands": ["echo coinbasket dev started."],
        "parallel": false,
        "stream": true
      }
    },
    "start:data_agent": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./nx start data_agent",
        "stream": true
      }
    },
    "start:api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./nx start api",
        "stream": true,
        "readyWhen": "Invest Agent Ready"
      }
    },
    "start:worker:api": {
      "executor": "nx:run-commands",
      "dependsOn": ["start:api"],
      "options": {
        "command": "./nx start:worker api",
        "stream": true
      }
    },
    "start:all": {
      "executor": "nx:run-commands",
      "dependsOn": ["start:data_agent", "start:worker:api"],
      "options": {
        "commands": ["echo coinbasket production started."],
        "parallel": false,
        "stream": true
      }
    }
  }
}